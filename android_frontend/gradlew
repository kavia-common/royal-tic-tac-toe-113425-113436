#!/bin/sh

##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to set JAVA_HOME if not set
if [ -z "$JAVA_HOME" ] ; then
  JAVA_PATH=`which java 2>/dev/null`
  if [ -n "$JAVA_PATH" ] ; then
    JAVA_HOME_CANDIDATE=`dirname $JAVA_PATH`/..
    if [ -x "$JAVA_HOME_CANDIDATE/bin/java" ] ; then
      JAVA_HOME=$JAVA_HOME_CANDIDATE
    fi
  fi
fi

# Use bash if possible for better compatibility
if [ -z "$BASH" ]; then
  BASH=$(which bash)
fi

APP_HOME=$(cd "`dirname \"$0\"`" >/dev/null 2>&1 && pwd)

# Locate the wrapper jar
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Setup JVM opts
DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'

# Adjust for OS
cygwin=false
msys=false
darwin=false
nonstop=false
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  Darwin*) darwin=true ;;
  MINGW*) msys=true ;;
  NONSTOP*) nonstop=true ;;
esac

if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
        exit 1
    fi
else
    JAVACMD="java"
fi

# Unix/Windows workaround for line endings and options
if $cygwin || $msys ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`
fi

# JVM Args
GRADLE_JVM_OPTS="$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS"

# Build command array preserving quoting
set -- $GRADLE_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"

exec "$JAVACMD" "$@"
